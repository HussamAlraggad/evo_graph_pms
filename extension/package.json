{
  "name": "evograph-nonlinear",
  "displayName": "EvoGraph Nonlinear (working title)",
  "description": "Non-linear AI-assisted coding: snapshots of code and AI interaction as a branching checkpoint graph.",
  "version": "0.1.0",
  "private": true,
  "publisher": "hussamalraggad",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "evograph.createCheckpoint",
        "title": "Create Checkpoint",
        "category": "EvoGraph"
      },
      {
        "command": "evograph.switchCheckpoint",
        "title": "Switch to Checkpoint…",
        "category": "EvoGraph"
      },
      {
        "command": "evograph.openGraph",
        "title": "Open Checkpoint File",
        "category": "EvoGraph"
      },
      {
        "command": "evograph.setAssistantApiKey",
        "title": "Set Assistant API Key…",
        "category": "EvoGraph"
      }
    ],
    "configuration": {
      "title": "EvoGraph",
      "properties": {
        "evograph.assistant.baseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "order": 1,
          "markdownDescription": "Base URL of an OpenAI-compatible chat completions endpoint (OpenAI, OpenRouter, a local Ollama or LM Studio server). The assistant calls `<baseUrl>/chat/completions`."
        },
        "evograph.assistant.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "order": 2,
          "markdownDescription": "Model id sent with every request. Pin an exact version for study runs (for example `gpt-4o-2024-08-06`); each AI checkpoint records the provider, model and version that produced it."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "evograph",
          "title": "EvoGraph",
          "icon": "media/evograph.svg"
        }
      ]
    },
    "views": {
      "evograph": [
        {
          "id": "evograph.assistant",
          "name": "Assistant",
          "type": "webview"
        },
        {
          "id": "evograph.history",
          "name": "Checkpoint File",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src test media",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run compile"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "1.106.0",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
